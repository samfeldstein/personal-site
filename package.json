{
  "name": "personal-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/sync.mjs --check && node scripts/check.mjs && node scripts/version.mjs",
    "photos": "node scripts/photos.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "dev": "wrangler dev",
    "dev:phone": "wrangler dev --ip 0.0.0.0",
    "projects": "node scripts/projects.mjs"
  },
  "devDependencies": {
    "exiftool-vendored": "^36.0.0",
    "sharp": "^0.35.5",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261012.1": true
  }
}
